{
  "description": "apb: append one line per event to .apb/events.jsonl in an apb project, so the orchestrator can see what agents are doing and time each step. When the orchestrator's work runs out, its message must say who holds the ball, and a GitHub fact it states must come from a lookup in the same turn (gh, git, or the map or progress-page script). A brief to a builder or reviewer that tells it how to format or post its work is refused; a report that says it departed from its file sends back every hand-off to the human, up to 3 times a turn, until the orchestrator resolves it.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] },
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-brief.py"], "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-brief.py"], "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "TaskCreated": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "TaskCompleted": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-stop.py"], "timeout": 10 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ]
  }
}
