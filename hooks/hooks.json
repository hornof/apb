{
  "description": "apb: in an apb project (docs/MAP.md) or the apb repo itself (hooks/apb_folder.py), append one line per event to .apb/events.jsonl, so the orchestrator can see what agents are doing and time each step. Keep the watcher (scripts/apb-watch.py) running for the orchestrator, on the project's repo and the coordination issue (a second watcher when that issue is in another repo), and wake it when a watcher finds something. When the orchestrator's work runs out, its message must say who holds the ball, and a GitHub fact it states must come from a lookup in the same turn (gh, git, or the map or progress-page script). A hand-off of an apb PR that touches templates/, hooks/, agents/, a skill's SKILL.md or docs/playbook.md is sent back once if the PR's description has no \"Projects:\" line. A brief to a builder or reviewer that tells it how to format or post its work is refused; a report that says it departed from its file sends back every hand-off to the human, up to 3 times a turn, until the orchestrator resolves it.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-watch-start.py"], "asyncRewake": true, "timeout": 86400 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] },
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-watch-start.py"], "asyncRewake": true, "timeout": 86400 } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] },
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-brief.py"], "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion|mcp__ccd_turn__wrap_up", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-popups.py"], "timeout": 10 } ] },
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-brief.py"], "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-watch-start.py"], "asyncRewake": true, "timeout": 86400 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "TaskCreated": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "TaskCompleted": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-stop.py"], "timeout": 10 } ] },
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-watch-start.py"], "asyncRewake": true, "timeout": 86400 } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/apb-events.py"], "async": true } ] }
    ]
  }
}
